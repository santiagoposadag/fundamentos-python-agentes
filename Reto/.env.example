# La clave secreta que deben enviar los clientes en el header X-API-KEY
# para poder usar los endpoints de escritura (crear misiones, completarlas, etc.)
AGENCIA_API_KEY=api-key-placeholder

# URL base de la API pública de países
EXTERNAL_API_URL=https://restcountries.com/v3.1

# Ruta del archivo de base de datos SQLite
DB_PATH=agentes.db
